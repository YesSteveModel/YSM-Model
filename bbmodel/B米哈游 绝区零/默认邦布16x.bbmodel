lse,"saved":true,"path":"","anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"effects":{"name":"效果","type":"effect","keyframes":[{"channel":"timeline","data_points":[{"script":"v.L1_P1=v.L1_P0+0.01*v.L1_P0dot;\nv.L2_P1=v.L2_P0+0.01*v.L2_P0dot;\nv.L3_P1=v.L3_P0+0.01*v.L3_P0dot;\nv.L4_P1=v.L4_P0+0.01*v.L4_P0dot;\nv.L5_P1=v.L5_P0+0.01*v.L5_P0dot;\nv.L6_P1=v.L6_P0+0.01*v.L6_P0dot;\nv.L6_P10=v.L6_P00+0.01*v.L6_P00dot;\nv.L7_P1=v.L7_P0+0.01*v.L7_P0dot;\nv.L8_P1=v.L8_P0+0.01*v.L8_P0dot;\nv.L9_P1=v.L9_P0+0.01*v.L9_P0dot;\nv.L10_P1=v.L10_P0+0.01*v.L10_P0dot;\nv.L11_P1=v.L11_P0+0.01*v.L11_P0dot;\n'头发垂直速度物理';\nv.L1_P1dot=v.L1_P0dot+0.01*(v.L1_K3*math.clamp(q.vertical_speed+v.hv,-30,1)-v.L1_P1-v.L1_K1*v.L1_P0dot)/v.L1_K2;\n'头发水平速度物理';\nv.L2_P1dot=v.L2_P0dot+0.01*(v.L2_K3*math.clamp(2*q.ground_speed+v.hg,0,30)-v.L2_P1-v.L2_K1*v.L2_P0dot)/v.L2_K2;\n'头发水平角速度物理';\nv.L3_P1dot=v.L3_P0dot+0.01*(v.L3_K3*math.clamp(q.yaw_speed,-600,600)-v.L3_P1-v.L3_K1*v.L3_P0dot)/v.L3_K2;\n'胸部水平角速度物理';\nv.L4_P1dot=v.L4_P0dot+0.01*(v.L4_K3*math.clamp((math.min(q.yaw_speed,-300)+math.max(q.yaw_speed,300)),-300,300)-v.L4_P1-v.L4_K1*v.L4_P0dot)/v.L4_K2;\n'玩家头发垂直角度物理';\nv.L5_P1dot=v.L5_P0dot+0.01*(v.L5_K3*(ysm.head_pitch>-40?ysm.head_pitch:-40)-v.L5_P1-v.L5_K1*v.L5_P0dot)/v.L5_K2;\n'玩家头部水平角度物理';\nv.L6_P1dot=v.L6_P0dot+0.01*(v.L6_K3*ysm.head_yaw-v.L6_P1-v.L6_K1*v.L6_P0dot)/v.L6_K2;\n'玩家头部垂直角度物理';\nv.L6_P10dot=v.L6_P00dot+0.01*(v.L6_K3*ysm.head_pitch-v.L6_P10-v.L6_K1*v.L6_P00dot)/v.L6_K2;\n'胸部垂直速度物理';\nv.L7_P1dot=v.L7_P0dot+0.01*(v.L7_K3*math.clamp(q.vertical_speed+v.bv,-30,30)-v.L7_P1-v.L7_K1*v.L7_P0dot)/v.L7_K2;\n'胸部水平速度物理';\nv.L8_P1dot=v.L8_P0dot+0.01*(v.L8_K3*math.clamp(q.ground_speed+v.bg,0,20)-v.L8_P1-v.L8_K1*v.L8_P0dot)/v.L8_K2;\n'玩家x坐标增量物理';\nv.L9_P1dot=v.L9_P0dot+0.01*(v.L9_K3*(100*query.position_delta(0))-v.L9_P1-v.L9_K1*v.L9_P0dot)/v.L9_K2;\n'玩家y坐标增量物理';\nv.L10_P1dot=v.L10_P0dot+0.01*(v.L10_K3*(100*query.position_delta(1))-v.L10_P1-v.L10_K1*v.L10_P0dot)/v.L10_K2;\n'玩家z坐标增量物理';\nv.L11_P1dot=v.L11_P0dot+0.01*(v.L11_K3*(100*query.position_delta(2))-v.L11_P1-v.L11_K1*v.L11_P0dot)/v.L11_K2;"}],"uuid":"1e0e884d-34fc-a9d0-12b7-db01135142b3","time":0,"color":-1,"interpolation":"linear"},{"channel":"timeline","data_points":[{"script":"v.L1_P0=v.L1_P1;\nv.L2_P0=v.L2_P1;\nv.L3_P0=v.L3_P1;\nv.L4_P0=v.L4_P1;\nv.L5_P0=v.L5_P1;\nv.L6_P0=v.L6_P1;\nv.L6_P00=v.L6_P10;\nv.L7_P0=v.L7_P1;\nv.L8_P0=v.L8_P1;\nv.L9_P0=v.L9_P1;\nv.L10_P0=v.L10_P1;\nv.L11_P0=v.L11_P1;\nv.L1_P0dot=v.L1_P1dot;\nv.L2_P0dot=v.L2_P1dot;\nv.L3_P0dot=v.L3_P1dot;\nv.L4_P0dot=v.L4_P1dot;\nv.L5_P0dot=v.L5_P1dot;\nv.L6_P0dot=v.L6_P1dot;\nv.L6_P00dot=v.L6_P10dot;\nv.L7_P0dot=v.L7_P1dot;\nv.L8_P0dot=v.L8_P1dot;\nv.L9_P0dot=v.L9_P1dot;\nv.L10_P0dot=v.L10_P1dot;\nv.L11_P0dot=v.L11_P1dot;"}],"uuid":"d40bf0b6-086e-c9ba-c723-308c6d216181","time":0.0101,"color":-1,"interpolation":"linear"}]}}},{"uuid":"7bc34bff-004f-2f41-1582-fbc2dc5b1897","name":"parallel4","loop":"loop","override":false,"length":0,"snapping":25,"selected":false,"saved":true,"path":"","anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":""},{"uuid":"ed1e5646-5918-3c6a-a7ce-793a7a3313a8","name":"parallel5","loop":"loop","override":false,"length":0,"snapping":25,"selected":false,"saved":true,"path":"","anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":""},{"uuid":"0a507be3-3207-8420-6029-73a282309eca","name":"parallel6","loop":"loop","override":false,"length":0,"snapping":25,"selected":false,"saved":true,"path":"","anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":""},{"uuid":"e206bdf2-56f2-5fce-ec6b-5d0a817863d3","name":"parallel7","loop":"loop","override":false,"length":0,"snapping":25,"selected":false,"saved":true,"path":"","anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":""},{"uuid":"b082d337-2505-cb1c-3384-36d6a4a00f18","name":"pre_parallel1","loop":"loop","override":false,"length":7.68,"snapping":25,"selected":false,"saved":true,"path":""